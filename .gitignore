# Godot editor/import cache
.godot/

# Raw downloaded source data: never committed (see docs/DATA_SOURCES.md)
data/raw/

# Local Godot binary installed by `make setup` (about 146 MB, never committed)
tools/godot/
ephemeris/target/

# Cargo build output of the texture preparation tool
tools/texture-prep/target/

# Cargo build output of the Milestone 2 moon-data tool
tools/moon-data/target/

# Earth Milestone 1: monthly Blue Marble images, downloaded by `make earth-texture` (see docs/DATA_SOURCES.md)
assets/earth/bmng/

# Cargo build output of the Moon data pipeline
tools/moon-data/target/

# LDEM_64 tiles (531 MB), generated by `make moon-data` (docs/specs/lunar-surface-procedural.md REQ-1, A5)
assets/elevation/ldem64/

# Cargo build output of the native terrain library
native/lunar-terrain/target/

# Native library copied here by `make native`
assets/native/*.so
